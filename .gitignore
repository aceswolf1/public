# ignore everything in the root except the "wp-content" directory.
!wp-content/
!docker*
wp-content/uploads/*
!wp-content/plugins/
!scripts/
# ignore all files starting with .
.*

# ignore all files that start with ~
~*

# ignore OS generated files
ehthumbs.db
Thumbs.db

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
.DS_Store

# ignore node dependency directories
node_modules/

# track this file .gitignore (i.e. do NOT ignore it)
!.gitignore

# track .editorconfig file (i.e. do NOT ignore it)
!.editorconfig

# track eslint files (i.e. do NOT ignore them)
!.eslintignore
!.eslintrc.json

# track readme.md in the root (i.e. do NOT ignore it)
!readme.md

# ignore vendors directory:
vendor/*
vendor/composer/*
deploy.sh

## OS GENERATED FILES
#####################
.DS_Store
.DS_Store?
.localized
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
[Tt]humbs.db
sftp-config.json
.well-known
.bash*
.vi*
.vscode
.idea
.php-ini
.php-version
.devilbox

# LOGS, DATABASES AND MISC
# ########################
*.log
*.sqlite
*.sass-cache
/web/wp-content/plugins/easy-wp-smtp/logs/

# Ignore Core WordPress Files
wp-admin/
wp-includes/
wp-config.php
wp-activate.php
wp-blog-header.php
xmlrpc.php
wp-trackback.php
wp-signup.php
wp-settings.php
wp-mail.php
wp-login.php
wp-load.php
wp-links-opml.php
wp-cron.php
wp-comments-post.php
wp-config-sample.php
readme.html
local-xdebuginfo.php
index.php
license.txt
unlimited-elements-for-elementor.png
deploy.sh
error_log.txt

#Ignore converted images
/wp-content/uploads-webpc/
/wp-content/cache
wp-content/cache/css

wp-cli.yml
wp-config.php.bak
wp-config.php.bak2
wp-content/jetpack-waf/
wp-content/mu-plugins/local-by-flywheel-live-link-helper.php
wp-content/endurance-page-cache/
wp-content/endurance-page-cache/*
